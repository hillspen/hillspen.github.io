---
---
{% comment %}
  Compact entry used for "selected publications" on the homepage:
  linked title, authors, venue + year. Nothing else.
  Title link priority: arXiv, url, doi, html, pdf.
{% endcomment %}
{% assign title_link = nil %}
{% if entry.arxiv %}
  {% capture title_link %}https://arxiv.org/abs/{{ entry.arxiv }}{% endcapture %}
{% elsif entry.url %}
  {% assign title_link = entry.url %}
{% elsif entry.doi %}
  {% if entry.doi contains '://' %}
    {% assign title_link = entry.doi %}
  {% else %}
    {% capture title_link %}https://doi.org/{{ entry.doi }}{% endcapture %}
  {% endif %}
{% elsif entry.html %}
  {% if entry.html contains '://' %}
    {% assign title_link = entry.html %}
  {% else %}
    {% assign title_link = entry.html | prepend: '/assets/html/' | relative_url %}
  {% endif %}
{% elsif entry.pdf %}
  {% if entry.pdf contains '://' %}
    {% assign title_link = entry.pdf %}
  {% else %}
    {% assign title_link = entry.pdf | prepend: '/assets/pdf/' | relative_url %}
  {% endif %}
{% endif %}

{% assign proceedings = 'inproceedings,incollection' | split: ',' %}
{% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
{% if entry.type == 'article' %}
  {% assign venue = entry.journal %}
{% elsif proceedings contains entry.type %}
  {% assign venue = entry.booktitle %}
{% elsif thesis contains entry.type %}
  {% assign venue = entry.school %}
{% else %}
  {% assign venue = '' %}
{% endif %}

<div id="{{ entry.key }}" class="compact-entry">
  <div class="title">
    {% if title_link %}<a href="{{ title_link }}">{{ entry.title }}</a>{% else %}{{ entry.title }}{% endif %}
  </div>
  <div class="author">
    {% include bib_authors.liquid %}
  </div>
  <div class="periodical">
    {% if venue != '' %}<em>{{ venue }}</em>{% if entry.year %}, {% endif %}{% endif %}{{ entry.year }}
  </div>
</div>
