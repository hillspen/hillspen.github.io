{% comment %}
  Renders the news list from _includes/news.md.
  Each item is a line "- Mon YYYY | text"; items appear in file order (newest first).
  On the homepage (include.limit), only the first page.announcements.limit items are shown.
{% endcomment %}
{% capture news_source %}{% include news.md %}{% endcapture %}
{% assign news_lines = news_source | newline_to_br | split: '<br />' %}
{% if include.limit and page.announcements.limit %}
  {% assign news_limit = page.announcements.limit | plus: 0 %}
{% else %}
  {% assign news_limit = 1000 %}
{% endif %}
<div class="news">
  <div class="table-responsive">
    <table class="table table-sm table-borderless">
      {% assign news_count = 0 %}
      {% for raw_line in news_lines %}
        {% assign line = raw_line | strip %}
        {% assign prefix = line | slice: 0, 2 %}
        {% if prefix != '- ' %}{% continue %}{% endif %}
        {% if news_count >= news_limit %}{% break %}{% endif %}
        {% assign parts = line | remove_first: '- ' | split: ' | ' %}
        {% assign news_date = parts | first | strip %}
        {% assign news_text = line | remove_first: '- ' | remove_first: parts[0] | remove_first: ' | ' | strip %}
        <tr>
          <th scope="row" style="width: 20%">{{ news_date }}</th>
          <td>{{ news_text | replace: '|', '\|' | markdownify | remove: '<p>' | remove: '</p>' | strip }}</td>
        </tr>
        {% assign news_count = news_count | plus: 1 %}
      {% endfor %}
    </table>
  </div>
</div>
